{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifebase:schema:event:v1",
  "title": "Lifebase event v1",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": 1
    },
    "event_type": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "known_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "record_id",
    "revision_id",
    "schema_version",
    "event_type",
    "title",
    "occurred_at",
    "known_at"
  ],
  "additionalProperties": false
}
