{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifebase HumanOS JSON CLI v1",
  "type": "object",
  "required": [
    "api_version",
    "tool",
    "status",
    "snapshot_id",
    "data",
    "warnings"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "tool": {
      "enum": [
        "graph.build",
        "graph.status",
        "graph",
        "topics",
        "conversations",
        "search",
        "timeline",
        "evidence",
        "context"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "empty",
        "missing",
        "stale",
        "error"
      ]
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "data": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "generated_answer": {
          "type": "null"
        },
        "content_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        },
        "destination": {
          "enum": [
            "local",
            "cloud"
          ]
        },
        "conversations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/conversation"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "const": "context"
          },
          "status": {
            "enum": [
              "ok",
              "empty"
            ]
          }
        },
        "required": [
          "tool",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "question",
              "destination",
              "content_chars",
              "generated_answer",
              "matches"
            ],
            "properties": {
              "matches": {
                "maxItems": 10
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "conversations"
          },
          "status": {
            "enum": [
              "ok",
              "empty"
            ]
          }
        },
        "required": [
          "tool",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "total",
              "offset",
              "next_offset",
              "conversations"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "record_id",
        "revision_id",
        "conversation_id",
        "parent_record_id",
        "source",
        "role",
        "occurred_at",
        "known_at",
        "excerpt",
        "truncated",
        "score",
        "matched_topics",
        "graph_path",
        "evidence",
        "version_conflict"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "parent_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "known_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 300
        },
        "truncated": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "matched_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graph_path": {
          "$ref": "#/$defs/graph_path"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "version_conflict": {
          "type": "boolean"
        }
      }
    },
    "graph_path": {
      "type": "object",
      "required": [
        "source_node_id",
        "conversation_node_id",
        "message_node_id",
        "topic_node_ids"
      ],
      "properties": {
        "source_node_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "conversation_node_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "message_node_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "topic_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "record_kind",
        "record_id",
        "revision_id",
        "source",
        "source_record_id",
        "content_hash",
        "raw_member",
        "raw_member_hash",
        "raw_pointer",
        "collector_version",
        "parser_version"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "record_kind": {
          "enum": [
            "event",
            "artifact"
          ]
        },
        "record_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source": {
          "type": "string"
        },
        "source_record_id": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_member": {
          "type": "string"
        },
        "raw_member_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_pointer": {
          "type": "string"
        },
        "collector_version": {
          "type": "string"
        },
        "parser_version": {
          "type": "string"
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message",
        "count"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "conversation": {
      "type": "object",
      "required": [
        "conversation_id",
        "source",
        "title",
        "title_truncated",
        "first_message_at",
        "last_message_at",
        "messages",
        "user_messages",
        "top_topics",
        "evidence_ids",
        "version_conflict"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "title_truncated": {
          "type": "boolean"
        },
        "first_message_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_message_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "user_messages": {
          "type": "integer",
          "minimum": 0
        },
        "top_topics": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "version_conflict": {
          "type": "boolean"
        }
      }
    }
  }
}
